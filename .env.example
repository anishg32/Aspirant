# ========================================================
# YOU ASPIRANT — AI ASSISTANT MODEL PROVIDER CONFIGURATION
# ========================================================
# Aspirant Navigator works out of the box with its built-in
# conversational multi-turn engine. To connect a live cloud LLM,
# create a file named `.env.local` and configure one of the following:

# OPTION 1: Google Gemini (Recommended - Fast & Free Tier available)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OPTION 2: OpenAI (GPT-4o / GPT-4o-mini)
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OPTION 3: Groq (Ultra-low latency Llama-3.3-70B)
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 4: OpenRouter (Universal AI aggregator)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
